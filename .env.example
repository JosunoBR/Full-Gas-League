# =============================================================================
# CONFIGURAÇÃO DE E-MAILS - RESEND (FullGas League)
# =============================================================================
# 1. Crie sua conta gratuita em: https://resend.com
# 2. Vá em 'API Keys', clique em 'Create API Key' e cole o valor abaixo:
RESEND_API_KEY=re_coloque_sua_chave_aqui

# Remetente Oficial:
# - Durante os testes (antes de validar seu domínio): use 'onboarding@resend.dev'
# - Em produção (com domínio validado): use 'FullGas League <contato@fullgasleague.com.br>'
MAIL_DEFAULT_SENDER=FullGas League <contato@fullgasleague.com.br>

# Para onde vão as respostas se um piloto responder ao e-mail:
MAIL_REPLY_TO=fullgasracingf1@gmail.com

# URL base para os links enviados no e-mail (botão de defesa, portal, etc.):
BASE_URL=https://fullgasleague.com.br
